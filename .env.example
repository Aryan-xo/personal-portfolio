# Lifts the unauthenticated GitHub rate limit and, with read:user, returns the
# full-year contribution calendar instead of ~90 days of public events.
# Classic token, scope: read:user
GITHUB_TOKEN=

# Created while signed in as the work account. With read:user it returns that
# account's contribution calendar (daily counts only). With repo — or a
# fine-grained token granting Metadata: read — the stats route also reports the
# language split across private repositories.
#
# Only aggregate percentages and daily counts are ever returned to the browser:
# repository names, descriptions and URLs are never included for an account
# whose repositories are private. See app/api/stats/route.ts.
GITHUB_WORK_TOKEN=
